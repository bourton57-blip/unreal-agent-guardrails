{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bourton57-blip/unreal-agent-guardrails/blob/main/schemas/toolchain-manifest.schema.json",
  "title": "unreal-agent-guardrails toolchain manifest",
  "description": "Declarative pins for external artifacts used by an agent workflow.",
  "type": "object",
  "required": ["schemaVersion", "name", "components"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "generatedBy": { "type": "string" },
    "generatedAt": { "type": "string" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "revision": { "type": ["string", "null"] },
          "license": { "type": ["string", "null"] },
          "licenseUrl": { "type": ["string", "null"] },
          "source": { "type": ["string", "null"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
